# recovery-erofs: mounts the erofs image with the rest of the recovery (see montar_extra.sh).
# It goes in /system/etc/init/, which init parses AFTER /system/etc/init/hw/init.rc: this action
# runs at the end of "early-init" (after "start ueventd") and before "on init", when no service
# has started yet. "exec" blocks init until it finishes.
on early-init
    exec u:r:recovery:s0 root root -- /system/bin/sh /system/bin/montar_extra.sh
