on early-init
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1

on init
    write /sys/class/backlight/panel0-backlight/brightness 200
    setprop sys.usb.configfs 1
    start vendor.cargarmods

# malmo: vendor_dlkm modules that recovery needs (charger, USB, battery, touch). Without them,
# under fw_devlink.strict=1, qpnp-smb5 and everything hanging off it defers forever. See
# /system/bin/cargar_modulos.sh. It is a service so init is not blocked.
service vendor.cargarmods /system/bin/sh /system/bin/cargar_modulos.sh
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

# malmo (blair): the glue dwc3-msm is 4e00000.ssusb, not a600000.ssusb of other SoCs.
on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

    # Load ADSP firmware for PMIC
    mkdir /firmware
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro context=u:object_r:firmware_file:s0

on property:dev.mnt.blk.firmware=*
    write /sys/kernel/boot_adsp/boot 1

service charger /system/bin/sh -c "exit 0"
    class charger
    disabled
    seclabel u:r:recovery:s0

on property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC 4e00000.dwc3

on property:sys.usb.config=mtp,adb
    start adbd

on property:sys.usb.config=mtp,adb && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idProduct 0x${ro.recovery.usb.adb.pid}
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
    rm /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC 4e00000.dwc3
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=mtp
    setprop sys.usb.config mtp,adb
