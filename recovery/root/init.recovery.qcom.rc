# init.recovery.qcom.rc — OrangeFox / TWRP malmo
# Integration of Motorola malmo decrypt (KeyMint AIDL / Gatekeeper QTI) with touch, USB & battery watchdog.

import /init.recovery.qcom_decrypt.rc

on early-init
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1

on init
    # Igualar el osVersion que ve el HAL de keymint con el del blob de /metadata
    # (OS_VERSION 170000 = 17.0.0). TWRP trae release_or_codename=14; el TA compara
    # osVersion del blob con el del arranque actual.
    exec - root root -- /system/bin/resetprop ro.build.version.release_or_codename 17
    start twrpdiag
    write /sys/class/backlight/panel0-backlight/brightness 1200
    setprop sys.usb.configfs 1
    # prepdecrypt: el recovery es partición propia, pero forzamos igualar el parche con la ROM
    setprop prepdecrypt.setpatch true
    setprop prepdecrypt.loglevel 2
    # Start touchscreen and battery watchdog modules
    start vendor.cargarmods

# malmo: vendor_dlkm modules that recovery needs (touch, battery watchdog).
service vendor.cargarmods /system/bin/sh /system/bin/cargar_modulos.sh
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

# malmo (blair): the dwc3-msm glue is 4e00000.ssusb (not a600000.ssusb). It only shows up once
# TWRP loads the charger modules (TW_LOAD_VENDOR_MODULES), so peripheral mode and binding the
# gadget go in a service (usb_tardio.sh). No "wait" here: that blocked init 5 s.
on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    start vendor.usbtardio

service vendor.usbtardio /system/bin/sh /system/bin/usb_tardio.sh
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw

    # Firmware del modem: se monta UNA vez en /vendor/firmware_mnt (ruta que usa Android y
    # donde el HAL de keymint busca el TA 5.3). Montarlo tambien en /firmware daba EBUSY.
    mkdir /vendor/firmware_mnt
    mount ext4 /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /vendor/firmware_mnt ro
    symlink /vendor/firmware_mnt /firmware
    # Desbloquea prepdecrypt/qseecomd/keymint (parche 0002 de twrp-common): asi el HAL
    # encuentra el firmware y carga el TA 5.3 en el arranque en frio.
    setprop twrp.fw_mnt 1

    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0660 /dev/smcinvoke
    chown system system /dev/smcinvoke

    # DMA-BUF heaps: Android sets /dev/dma_heap/qcom,* 0444 system system (ueventd of the ROM's vendor).
    chown system system /dev/dma_heap/qcom,display
    chmod 0444 /dev/dma_heap/qcom,display
    chown system system /dev/dma_heap/qcom,qseecom
    chmod 0444 /dev/dma_heap/qcom,qseecom
    chown system system /dev/dma_heap/qcom,qseecom-ta
    chmod 0444 /dev/dma_heap/qcom,qseecom-ta
    chown system system /dev/dma_heap/qcom,secure-cdsp
    chmod 0444 /dev/dma_heap/qcom,secure-cdsp
    chown system system /dev/dma_heap/qcom,secure-non-pixel
    chmod 0444 /dev/dma_heap/qcom,secure-non-pixel
    chown system system /dev/dma_heap/qcom,secure-pixel
    chmod 0444 /dev/dma_heap/qcom,secure-pixel
    chown system system /dev/dma_heap/qcom,system
    chmod 0444 /dev/dma_heap/qcom,system
    chown system system /dev/dma_heap/qcom,system-uncached
    chmod 0444 /dev/dma_heap/qcom,system-uncached

    # UFS BSG (transporte RPMB): el kernel lo crea root:root 0600 y qseecomd (uid 1000/system)
    chown system system /dev/0:0:0:49456
    chmod 0660 /dev/0:0:0:49456
    chown system system /dev/0:0:0:49476
    chmod 0660 /dev/0:0:0:49476
    chown system system /dev/0:0:0:49488
    chmod 0660 /dev/0:0:0:49488

on property:dev.mnt.blk.firmware=*
    write /sys/kernel/boot_adsp/boot 1

on boot
    write /sys/fs/selinux/enforce 0

# qseecomd start
on property:crypto.ready=1
    start hwservicemanager
    start qseecomd

# --- Descifrado: KeyMint AIDL (A12+), no keymaster 4.x ---
on property:vendor.sys.listeners.registered=true
    start vendor.ssgtzd
    restart vendor.keymint-qti-twrp
    start vendor.gatekeeper-qti-twrp
    start gatekeeper-1-0-qti

on property:sys.listeners.registered=true
    start vendor.ssgtzd
    restart vendor.keymint-qti-twrp
    start vendor.gatekeeper-qti-twrp

on property:twrp.all.users.decrypted=true
    stop vendor.keymint-qti-twrp
    stop vendor.gatekeeper-qti-twrp

service vendor.keymint-qti-twrp /system/bin/android.hardware.security.keymint-service-qti
    user system
    group system drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64
    setenv LD_PRELOAD /vendor/lib64/liba17compat.so
    disabled
    seclabel u:r:shell:s0

service vendor.gatekeeper-qti-twrp /system/bin/android.hardware.gatekeeper-service-qti
    user system
    group system drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64
    setenv LD_PRELOAD /vendor/lib64/liba17compat.so
    disabled
    seclabel u:r:recovery:s0

service vendor.ssgtzd /vendor/bin/ssgtzd
    user system
    group system wakelock
    setenv LD_LIBRARY_PATH /vendor/lib64/a17:/vendor/lib64:/system/lib64
    socket ssgtzd stream 0660 system system
    socket ssgtzd_opener stream 0660 system system
    capabilities WAKE_ALARM BLOCK_SUSPEND
    disabled
    seclabel u:r:recovery:s0

service twrpdiag /system/bin/sh /system/bin/twrpdiag.sh
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

# Vibración (AW86927)
on property:twrp.modules.loaded=true
    start twrp-haptics-warmup

service twrp-haptics-warmup /system/bin/sh /system/bin/haptics_warmup.sh
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

service hwservicemanager /system/bin/hwservicemanager
    user system
    group system readproc
    critical
    disabled
    seclabel u:r:recovery:s0

service gatekeeper-1-0-qti /system/bin/android.hardware.gatekeeper@1.0-service-qti
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64/fogos:/vendor/lib64/hw:/vendor/lib64:/system/lib64
    disabled
    seclabel u:r:recovery:s0

# USB / ADB triggers
on property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC 4e00000.dwc3

on property:sys.usb.config=mtp,adb
    start adbd

on property:sys.usb.config=mtp,adb && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idProduct 0x${ro.recovery.usb.adb.pid}
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
    rm /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC 4e00000.dwc3
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=mtp
    setprop sys.usb.config mtp,adb
